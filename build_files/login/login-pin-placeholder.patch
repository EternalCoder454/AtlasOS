+// Telamon OS: whether the authselect profile has the with-pin feature, so the
+// password field's placeholder can say "Password or PIN". One bounded read of
+// /etc/authselect/authselect.conf at start; any failure means false. QML gets
+// this one boolean and no file access.
+class TelamonSignIn : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(bool pinSignIn READ pinSignIn CONSTANT)
+public:
+    explicit TelamonSignIn(QObject *parent = nullptr)
+        : QObject(parent)
+    {
+        QFile conf(QStringLiteral("/etc/authselect/authselect.conf"));
+        if (conf.open(QIODevice::ReadOnly)) {
+            m_pinSignIn = conf.read(4096).split('\n').contains(QByteArrayLiteral("with-pin"));
+        }
+    }
+    bool pinSignIn() const
+    {
+        return m_pinSignIn;
+    }
+
+private:
+    bool m_pinSignIn = false;
+};
+
 class LoginGreeter : public QObject
 {
