+PrepareUtil::~PrepareUtil()
+{
+    // Leaving the wizard must not cut a theme apply in half. finished() is
+    // emitted from inside waitForFinished, so finishApply knows to neither
+    // emit nor read config now, and to start a pending apply at most once.
+    m_shuttingDown = true;
+    QElapsedTimer deadline;
+    deadline.start();
+    while (m_applyProcess) {
+        QProcess *process = m_applyProcess;
+        const qint64 left = 5000 - deadline.elapsed();
+        if (left > 0 && process->waitForFinished(static_cast<int>(left))) {
+            continue; // finishApply may have started the pending one
+        }
+        if (m_applyProcess != process) {
+            continue; // it ended (or failed to start) meanwhile
+        }
+        // Past the deadline: give up on the rest.
+        m_hasPending = false;
+        process->disconnect(this);
+        process->kill();
+        process->waitForFinished(1000);
+        m_applyProcess = nullptr;
+    }
+}
+
+bool PrepareUtil::busy() const
+{
+    return m_busy;
+}
+
+void PrepareUtil::setBusy(bool busy)
+{
