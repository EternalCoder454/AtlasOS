+        m_busy = busy;
+        Q_EMIT busyChanged();
+    }
+}
+
+bool PrepareUtil::currentSchemeIsDark()
+{
+    // Read the file again: plasma-apply-lookandfeel changed it behind our back.
+    m_colorsSettings->config()->reparseConfiguration();
+    m_colorsSettings->load();
+    return m_colorsSettings->colorScheme() == u"AtlasOSDark"_s;
+}
+
+// AtlasOS: the selection changes at once and the theme follows in the
+// background, so the window keeps painting (the page fades from the old look
+// to the new one meanwhile) instead of freezing.
 void PrepareUtil::setUsingDarkTheme(bool usingDarkTheme)
+{
+    if (m_usingDarkTheme != usingDarkTheme) {
+        m_usingDarkTheme = usingDarkTheme;
+        Q_EMIT usingDarkThemeChanged();
+    }
+
+    if (m_applyProcess) {
+        // One at a time; the end state must match the last click.
+        m_hasPending = true;
+        m_pendingDark = usingDarkTheme;
+        return;
+    }
+    setBusy(true);
+    applyTheme(usingDarkTheme);
+}
+
+void PrepareUtil::applyTheme(bool dark)
 {
     // use plasma-apply-lookandfeel since it has logic for notifying the shell of changes
-    if (usingDarkTheme) {
-        QProcess::execute(u"plasma-apply-lookandfeel"_s, {QStringLiteral("--apply"), QStringLiteral("org.fedoraproject.fedoradark.desktop")});
-    } else {
-        QProcess::execute(u"plasma-apply-lookandfeel"_s, {QStringLiteral("--apply"), QStringLiteral("org.fedoraproject.fedora.desktop")});
+    const QString theme = dark ? u"org.atlasos.dark.desktop"_s : u"org.atlasos.desktop"_s;
+
+    auto *process = new QProcess(this);
+    m_applyProcess = process;
+    process->setProcessChannelMode(QProcess::SeparateChannels);
+
+    // A hung apply must not leave the wizard waiting for ever.
+    auto *timeout = new QTimer(process);
+    timeout->setSingleShot(true);
+    connect(timeout, &QTimer::timeout, process, [process] {
+        qWarning() << "plasma-apply-lookandfeel took more than 30 s, stopping it";
+        process->kill();
+    });
+
+    connect(process, &QProcess::errorOccurred, this, [this, process](QProcess::ProcessError error) {
+        // Only a failed start has no finished() after it.
+        if (error == QProcess::FailedToStart && m_applyProcess == process) {
+            const QString message = process->errorString();
+            m_applyProcess = nullptr;
+            process->deleteLater();
+            finishApply(false, message);
+        }
+    });
+    connect(process, &QProcess::finished, this, [this, process](int exitCode, QProcess::ExitStatus status) {
+        if (m_applyProcess != process) {
+            return;
+        }
+        m_applyProcess = nullptr;
+        const bool ok = status == QProcess::NormalExit && exitCode == 0;
+        const QString error = ok ? QString() : QString::fromLocal8Bit(process->readAllStandardError()).trimmed();
+        process->deleteLater();
+        finishApply(ok, ok ? QString() : (error.isEmpty() ? u"exit status %1"_s.arg(exitCode) : error));
+    });
+
+    process->start(u"plasma-apply-lookandfeel"_s, {u"--apply"_s, theme});
+    timeout->start(30000);
+}
+
+void PrepareUtil::finishApply(bool ok, const QString &error)
+{
+    if (!ok) {
+        qWarning() << "AtlasOS: applying the theme failed:" << error;
+    }
+
+    if (m_shuttingDown) {
+        // The destructor is waiting: run the newest wanted theme once, no signals.
+        if (m_hasPending) {
+            m_hasPending = false;
+            applyTheme(m_pendingDark);
+        }
+        return;
     }
 
-    m_usingDarkTheme = usingDarkTheme;
-    Q_EMIT usingDarkThemeChanged();
+    if (m_hasPending) {
+        // A newer click came in; it decides the end state, so go on to it.
+        // themeApplied is left out on purpose: busy stays true and the page
+        // keeps the old look until the last wanted theme is in.
+        m_hasPending = false;
+        applyTheme(m_pendingDark);
+        return;
+    }
+
+    if (!ok) {
+        // Show what the desktop really has.
+        const bool actual = currentSchemeIsDark();
+        if (actual != m_usingDarkTheme) {
+            m_usingDarkTheme = actual;
+            Q_EMIT usingDarkThemeChanged();
+        }
+    }
+    setBusy(false);
+    Q_EMIT themeApplied(ok);
 }
 
