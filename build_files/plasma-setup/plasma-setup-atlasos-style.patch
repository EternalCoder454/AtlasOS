diff --git a/src/components/qml/AtlasButton.qml b/src/components/qml/AtlasButton.qml
new file mode 100644
index 0000000..2ed952d
--- /dev/null
+++ b/src/components/qml/AtlasButton.qml
@@ -0,0 +1,127 @@
+// SPDX-FileCopyrightText: 2026 AtlasOS
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import QtQuick
+import QtQuick.Templates as T
+import org.kde.kirigami as Kirigami
+
+/*!
+    AtlasOS's button, as in Atlas.Ui 1.4: small rounded corners (4 px, 6 px
+    while pressed), 28 px tall, a grey hover and press layer; the accent
+    colour when prominent (the step forward), a quiet tint otherwise.
+*/
+T.AbstractButton {
+    id: control
+
+    property bool prominent: false
+    // Taller, for the one button on the welcome screen.
+    property bool large: false
+    readonly property color accent: Kirigami.Theme.highlightColor
+    readonly property color textTint: Kirigami.Theme.textColor
+
+    implicitWidth: Math.max(Math.round(Kirigami.Units.gridUnit * (large ? 9 : 5.5)), contentItem.implicitWidth + leftPadding + rightPadding)
+    implicitHeight: large ? 38 : 28
+    leftPadding: Kirigami.Units.gridUnit * (large ? 1.5 : 1)
+    rightPadding: leftPadding
+    hoverEnabled: true
+    focusPolicy: Qt.StrongFocus
+    scale: control.down && control.enabled ? 0.97 : 1
+
+    Accessible.role: Accessible.Button
+    Accessible.name: control.text
+    Keys.onReturnPressed: event => {
+        if (enabled && !event.isAutoRepeat) {
+            control.clicked();
+        }
+    }
+    Keys.onEnterPressed: event => {
+        if (enabled && !event.isAutoRepeat) {
+            control.clicked();
+        }
+    }
+
+    Behavior on scale {
+        NumberAnimation {
+            duration: Kirigami.Units.shortDuration
+            easing.type: Easing.OutCubic
+        }
+    }
+
+    contentItem: Item {
+        implicitWidth: row.implicitWidth
+        implicitHeight: row.implicitHeight
+        Row {
+            id: row
+            anchors.centerIn: parent
+            spacing: Kirigami.Units.smallSpacing
+            Kirigami.Icon {
+                visible: control.icon.name.length > 0
+                source: control.icon.name
+                isMask: true
+                color: label.color
+                width: Kirigami.Units.iconSizes.small
+                height: width
+                anchors.verticalCenter: parent.verticalCenter
+            }
+            Text {
+                id: label
+                anchors.verticalCenter: parent.verticalCenter
+                text: control.text
+                font.family: Kirigami.Theme.defaultFont.family
+                font.pointSize: Kirigami.Theme.defaultFont.pointSize * (control.large ? 1.15 : 1)
+                font.weight: control.prominent ? Font.DemiBold : Font.Normal
+                color: control.prominent && control.enabled ? Kirigami.Theme.highlightedTextColor : control.textTint
+                opacity: control.enabled ? 1 : 0.6
+                textFormat: Text.PlainText // no mnemonics
+            }
+        }
+    }
+
+    background: Rectangle {
+        // Small rounded corners (Atlas.Ui's radiusSmall, 4 px); pressed, 6 px.
+        radius: control.down && control.enabled ? 6 : 4
+        color: {
+            if (control.prominent) {
+                return control.enabled ? control.accent : Qt.alpha(control.textTint, 0.12);
+            }
+            return Qt.alpha(control.textTint, 0.07);
+        }
+        border.width: control.prominent && control.enabled ? 0 : 1
+        border.color: Qt.alpha(control.textTint, 0.2)
+        Behavior on radius {
+            NumberAnimation {
+                duration: Kirigami.Units.shortDuration
+                easing.type: Easing.OutCubic
+            }
+        }
+        Behavior on color {
+            ColorAnimation {
+                duration: Kirigami.Units.shortDuration
+            }
+        }
+        // The state layer: a grey over the fill, never the accent.
+        Rectangle {
+            anchors.fill: parent
+            radius: parent.radius
+            color: !control.enabled ? "transparent"
+                : control.down ? Qt.alpha(control.textTint, 0.16)
+                : control.hovered ? Qt.alpha(control.textTint, 0.08)
+                : "transparent"
+            Behavior on color {
+                ColorAnimation {
+                    duration: Kirigami.Units.shortDuration
+                }
+            }
+        }
+        // The keyboard focus ring, outside the button.
+        Rectangle {
+            anchors.fill: parent
+            anchors.margins: -3
+            radius: parent.radius + 3
+            color: "transparent"
+            border.width: 2
+            border.color: Qt.alpha(control.accent, 0.6)
+            visible: control.visualFocus
+        }
+    }
+}
