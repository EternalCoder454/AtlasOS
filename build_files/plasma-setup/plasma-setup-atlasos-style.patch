+++ b/src/components/qml/ChoiceCard.qml
@@ -0,0 +1,128 @@
+// SPDX-FileCopyrightText: 2026 AtlasOS
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Templates as T
+import org.kde.kirigami as Kirigami
+
+/*!
+    One of a few choices, shown as a picture with a name under it: an accent
+    ring and a check mark on the chosen one. Put the picture in `preview`.
+    Cards in the same parent are exclusive.
+*/
+T.AbstractButton {
+    id: control
+
+    property string description
+    property Component preview
+
+    checkable: true
+    autoExclusive: true
+    hoverEnabled: true
+    focusPolicy: Qt.StrongFocus
+    implicitWidth: Kirigami.Units.gridUnit * 11
+    implicitHeight: column.implicitHeight
+
+    Accessible.role: Accessible.RadioButton
+    Accessible.name: control.text
+    Accessible.description: control.description
+    Accessible.checkable: true
+    Accessible.checked: control.checked
+
+    contentItem: ColumnLayout {
+        id: column
+        spacing: Kirigami.Units.smallSpacing
+
+        Item {
+            Layout.fillWidth: true
+            Layout.preferredHeight: width * 10 / 16
+
+            // The ring sits just outside the picture, as in macOS's pickers.
+            Rectangle {
+                anchors.fill: parent
+                anchors.margins: -4
+                radius: Kirigami.Units.cornerRadius * 2 + 4
+                color: "transparent"
+                border.width: control.checked ? 3 : 2
+                border.color: control.checked ? Kirigami.Theme.highlightColor
+                    : control.hovered || control.visualFocus ? Qt.alpha(Kirigami.Theme.highlightColor, 0.45)
+                    : "transparent"
+                Behavior on border.color {
+                    ColorAnimation {
+                        duration: Kirigami.Units.shortDuration
+                    }
+                }
+                Behavior on border.width {
+                    NumberAnimation {
+                        duration: Kirigami.Units.shortDuration
+                        easing.type: Easing.OutCubic
+                    }
+                }
+            }
+            Loader {
+                id: picture
+                anchors.fill: parent
+                sourceComponent: control.preview
+            }
+            // A hairline edge, so a light picture stands out from a light
+            // card. (The picture rounds its own corners: DesktopPreview.)
+            Rectangle {
+                anchors.fill: parent
+                radius: Kirigami.Units.cornerRadius * 2
+                color: "transparent"
+                border.width: 1
+                border.color: Qt.alpha(Kirigami.Theme.textColor, 0.15)
+            }
+        }
+
+        RowLayout {
+            Layout.alignment: Qt.AlignHCenter
+            Layout.topMargin: Kirigami.Units.smallSpacing
+            spacing: Kirigami.Units.smallSpacing
+
+            // The check mark: filled with the accent colour when chosen.
+            Rectangle {
+                implicitWidth: Math.round(Kirigami.Units.gridUnit * 0.9)
+                implicitHeight: implicitWidth
+                radius: width / 2
+                color: control.checked ? Kirigami.Theme.highlightColor : "transparent"
+                border.width: control.checked ? 0 : 1
+                border.color: Qt.alpha(Kirigami.Theme.textColor, 0.35)
+                Behavior on color {
+                    ColorAnimation {
+                        duration: Kirigami.Units.shortDuration
+                    }
+                }
+                Kirigami.Icon {
+                    anchors.centerIn: parent
+                    width: parent.width * 0.75
+                    height: width
+                    visible: control.checked
+                    source: "checkmark-symbolic"
+                    isMask: true
+                    color: Kirigami.Theme.highlightedTextColor
+                }
+            }
+            Text {
+                text: control.text
+                font.family: Kirigami.Theme.defaultFont.family
+                font.pointSize: Kirigami.Theme.defaultFont.pointSize * 1.1
+                font.weight: Font.DemiBold
+                color: Kirigami.Theme.textColor
+                textFormat: Text.PlainText
+            }
+        }
+        Text {
+            Layout.fillWidth: true
+            visible: text.length > 0
+            text: control.description
+            horizontalAlignment: Text.AlignHCenter
+            wrapMode: Text.Wrap
+            font.family: Kirigami.Theme.defaultFont.family
+            font.pointSize: Kirigami.Theme.defaultFont.pointSize * 0.9
+            color: Kirigami.Theme.disabledTextColor
+            textFormat: Text.PlainText
+        }
+    }
+}
