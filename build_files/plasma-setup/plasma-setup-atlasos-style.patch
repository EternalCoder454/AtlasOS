diff --git a/modules/prepare/contents/ui/main.qml b/modules/prepare/contents/ui/main.qml
index 422088a..0a6d90e 100644
--- a/modules/prepare/contents/ui/main.qml
+++ b/modules/prepare/contents/ui/main.qml
@@ -1,87 +1,307 @@
 // SPDX-FileCopyrightText: 2023 Devin Lin <devin@kde.org>
 // SPDX-FileCopyrightText: 2025 Kristen McWilliam <kristen@kde.org>
+// SPDX-FileCopyrightText: 2026 AtlasOS
 //
 // SPDX-License-Identifier: GPL-2.0-or-later
 
 import QtQuick
-import QtQuick.Controls
 import QtQuick.Layouts
 
 import org.kde.kirigami as Kirigami
-import org.kde.kirigamiaddons.formcard as FormCard
 import org.kde.plasmasetup.prepareutil as Prepare
 import org.kde.plasmasetup.components as PlasmaSetupComponents
 
+// AtlasOS: Light or Dark as two pictures of the desktop, instead of a
+// "Dark Theme" switch.
 PlasmaSetupComponents.SetupModule {
     id: root
 
-    cardWidth: Math.min(Kirigami.Units.gridUnit * 30, root.contentItem.width - Kirigami.Units.gridUnit * 2)
+    // Not while a theme is still being applied.
+    nextEnabled: !Prepare.PrepareUtil.busy
 
-    nextEnabled: true
+    // The theme the person last clicked. usingDarkTheme itself is written a
+    // moment later while a fade starts, so clicks compare against this.
+    property bool wanted: Prepare.PrepareUtil.usingDarkTheme
+
+    function choose(dark: bool): void {
+        // Applying a Global Theme takes a moment; skip it when nothing changes.
+        if (dark === root.wanted) {
+            return;
+        }
+        root.wanted = dark;
+        fade.start(dark);
+    }
+
+    // The old look stays on top as a picture of the window and fades into the
+    // new one once the theme is applied (the way macOS and Windows 11 do).
+    // The picture never takes mouse input, so the page works throughout.
+    Item {
+        id: fade
+
+        // Kirigami.Units.longDuration is 0 under reduced motion: no fade.
+        readonly property bool enabledFade: Kirigami.Units.longDuration > 0
+        // The window's content item, looked up when a fade starts.
+        property Item target: null
+        property bool grabbing: false
+        // Counts grabs, so a callback from an abandoned one is ignored.
+        property int grabId: 0
+        // When the overlay went up, for the safety timer's absolute cap.
+        property double shownAt: 0
+        property var grabResult: null
+        // The newest wanted theme; every apply from here uses it.
+        property bool pendingDark: false
+
+        parent: target
+        anchors.fill: parent
+        z: 100000
+        visible: opacity > 0
+        opacity: 0
+        enabled: false
+
+        function apply(): void {
+            Prepare.PrepareUtil.usingDarkTheme = fade.pendingDark;
+        }
+
+        function start(dark: bool): void {
+            pendingDark = dark;
+            const win = page.Window.window;
+            if (!enabledFade || !win) {
+                console.info("AtlasOS wizard: no fade (enabledFade=" + enabledFade + ", window=" + (win ? "yes" : "none") + ")");
+                apply();
+                return;
+            }
+            if (grabbing) {
+                // The grab's callback applies the newest value.
+                console.info("AtlasOS wizard: fade already starting, newest choice kept");
+                return;
+            }
+            if (visible) {
+                // Still showing the old look: hold it until the newest theme is in.
+                console.info("AtlasOS wizard: fade held for a newer choice");
+                applyDelay.stop();
+                fadeOut.stop();
+                fadeDelay.stop();
+                safety.restart();
+                apply();
+                return;
+            }
+            console.info("AtlasOS wizard: fade starts");
+            const dpr = Math.max(1, win.devicePixelRatio);
+            // The window's own colour goes behind the picture, since the
+            // grab holds only the items.
+            backdrop.color = win.color;
+            grabbing = true;
+            const id = ++grabId;
+            grabGuard.restart();
+            const done = result => {
+                if (id !== fade.grabId) {
+                    // The guard already gave up on this grab.
+                    return;
+                }
+                grabGuard.stop();
+                fade.grabbing = false;
+                if (!result || result.url.toString() === "") {
+                    console.info("AtlasOS wizard: the window grab was empty, no fade");
+                    fade.apply();
+                    return;
+                }
+                fade.grabResult = result;
+                snapshot.source = result.url;
+                if (snapshot.status === Image.Error) {
+                    // The error handler has already cleared and applied.
+                    return;
+                }
+                fade.shownAt = Date.now();
+                fade.opacity = 1;
+                safety.restart();
+                // Let the picture paint once before the colours change.
+                applyDelay.restart();
+            };
+            const grab = item => item.grabToImage(done, Qt.size(Math.round(item.width * dpr), Math.round(item.height * dpr)));
+            let ok = false;
+            if (target) {
+                ok = grab(target);
+            } else {
+                // The picture covers the whole window, so it is taken of the
+                // page's highest ancestor that grabToImage accepts. The
+                // window's own root items weren't made by QML, and it refuses
+                // those ("item has no QML engine"). Found once, then kept.
+                const chain = [];
+                for (let item = page; item; item = item.parent) {
+                    chain.unshift(item);
+                }
+                for (const item of chain) {
+                    if (grab(item)) {
+                        target = item;
+                        ok = true;
+                        break;
+                    }
+                }
+            }
+            if (!ok) {
+                console.info("AtlasOS wizard: grabToImage refused, no fade");
+                grabbing = false;
+                grabGuard.stop();
+                apply();
+            }
+        }
+
+        function finish(): void {
+            // A frame or so for the new look to paint under the picture.
+            fadeDelay.restart();
+        }
+
+        function clear(): void {
+            safety.stop();
+            snapshot.source = "";
+            grabResult = null;
+            opacity = 0;
+        }
+
+        Timer {
+            id: applyDelay
+            interval: 50
+            onTriggered: fade.apply()
+        }
+        Timer {
+            id: fadeDelay
+            interval: 80
+            onTriggered: {
+                if (fade.visible) {
+                    fadeOut.restart();
+                }
+            }
+        }
+        // A grab whose callback never comes must not stop fades for good.
+        Timer {
+            id: grabGuard
+            interval: 2000
+            onTriggered: {
+                console.info("AtlasOS wizard: the window grab did not finish, no fade");
+                fade.grabId++;
+                fade.grabbing = false;
+                fade.apply();
+            }
+        }
+        // Whatever happens, the picture goes. An apply may take up to 30 s
+        // (PrepareUtil stops it then), so this waits a little longer.
+        Timer {
+            id: safety
+            interval: 32000
+            onTriggered: {
+                // A chain of applies on the C++ side may still be running: wait,
+                // up to 70 s after the picture went up.
+                if (Prepare.PrepareUtil.busy && Date.now() - fade.shownAt < 70000) {
+                    safety.restart();
+                    return;
+                }
+                if (!fade.visible)
+                    return; // No picture up (a grab failed): nothing to undo.
+                fadeOut.restart();
+            }
+        }
+        NumberAnimation {
+            id: fadeOut
+            target: fade
+            property: "opacity"
+            to: 0
+            duration: Kirigami.Units.longDuration + Kirigami.Units.shortDuration
+            easing.type: Easing.OutCubic
+            onFinished: fade.clear()
+        }
+
+        Rectangle {
+            id: backdrop
+            anchors.fill: parent
+        }
+        Image {
+            id: snapshot
+            anchors.fill: parent
+            fillMode: Image.Stretch
+            cache: false
+            smooth: true
+            asynchronous: false
+            onStatusChanged: {
+                if (status === Image.Error) {
+                    console.info("AtlasOS wizard: the snapshot did not load, no fade");
+                    applyDelay.stop();
+                    fade.clear();
+                    fade.apply();
+                }
+            }
+        }
+    }
+
+    Connections {
+        target: Prepare.PrepareUtil
+
+        function onThemeApplied(ok: bool): void {
+            if (applyDelay.running || fade.grabbing) {
+                // A click is still waiting to apply; this was an earlier
+                // apply finishing. Keep the picture until the newest is in.
+                safety.restart();
+                return;
+            }
+            if (!ok) {
+                // Back at what the desktop really has.
+                root.wanted = Prepare.PrepareUtil.usingDarkTheme;
+                fade.pendingDark = root.wanted;
+            }
+            fade.finish();
+        }
+    }
 
     contentItem: ColumnLayout {
+        id: page
+        spacing: Kirigami.Units.gridUnit
 
-        ColumnLayout {
+        Item {
+            Layout.fillHeight: true
+        }
+
+        Text {
+            Layout.fillWidth: true
             Layout.maximumWidth: root.cardWidth
-            Layout.alignment: Qt.AlignCenter
-            spacing: Kirigami.Units.smallSpacing
-
-            // TODO: Fix scaling support as seen here: https://invent.kde.org/plasma/plasma-setup/-/merge_requests/56
-
-            // Label {
-            // Layout.leftMargin: Kirigami.Units.gridUnit
