diff --git a/src/components/qml/AtlasButton.qml b/src/components/qml/AtlasButton.qml
new file mode 100644
index 0000000..8c6d3c3
--- /dev/null
+++ b/src/components/qml/AtlasButton.qml
@@ -0,0 +1,107 @@
+// SPDX-FileCopyrightText: 2026 AtlasOS
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import QtQuick
+import QtQuick.Templates as T
+import org.kde.kirigami as Kirigami
+
+/*!
+    AtlasOS's pill button, as in the Atlas apps: the accent colour when
+    prominent (the step forward), a quiet tint otherwise.
+*/
+T.AbstractButton {
+    id: control
+
+    property bool prominent: false
+    // Taller, for the one button on the welcome screen.
+    property bool large: false
+    readonly property color accent: Kirigami.Theme.highlightColor
+    readonly property color textTint: Kirigami.Theme.textColor
+
+    implicitWidth: Math.max(Math.round(Kirigami.Units.gridUnit * (large ? 9 : 5.5)), contentItem.implicitWidth + leftPadding + rightPadding)
+    implicitHeight: Math.round(Kirigami.Units.gridUnit * (large ? 2.4 : 1.9))
+    leftPadding: Kirigami.Units.gridUnit * (large ? 1.5 : 1)
+    rightPadding: leftPadding
+    hoverEnabled: true
+    focusPolicy: Qt.StrongFocus
+    scale: control.down && control.enabled ? 0.97 : 1
+
+    Accessible.role: Accessible.Button
+    Accessible.name: control.text
+    Keys.onReturnPressed: event => {
+        if (enabled && !event.isAutoRepeat) {
+            control.clicked();
+        }
+    }
+    Keys.onEnterPressed: event => {
+        if (enabled && !event.isAutoRepeat) {
+            control.clicked();
+        }
+    }
+
+    Behavior on scale {
+        NumberAnimation {
+            duration: Kirigami.Units.shortDuration
+            easing.type: Easing.OutCubic
+        }
+    }
+
+    contentItem: Item {
+        implicitWidth: row.implicitWidth
+        implicitHeight: row.implicitHeight
+        Row {
+            id: row
+            anchors.centerIn: parent
+            spacing: Kirigami.Units.smallSpacing
+            Kirigami.Icon {
+                visible: control.icon.name.length > 0
+                source: control.icon.name
+                isMask: true
+                color: label.color
+                width: Kirigami.Units.iconSizes.small
+                height: width
+                anchors.verticalCenter: parent.verticalCenter
+            }
+            Text {
+                id: label
+                anchors.verticalCenter: parent.verticalCenter
+                text: control.text
+                font.family: Kirigami.Theme.defaultFont.family
+                font.pointSize: Kirigami.Theme.defaultFont.pointSize * (control.large ? 1.15 : 1)
+                font.weight: control.prominent ? Font.DemiBold : Font.Normal
+                color: control.prominent && control.enabled ? Kirigami.Theme.highlightedTextColor : control.textTint
+                opacity: control.enabled ? 1 : 0.6
+                textFormat: Text.PlainText // no mnemonics
+            }
+        }
+    }
+
+    background: Rectangle {
+        radius: height / 2
+        color: {
+            if (control.prominent) {
+                if (!control.enabled) {
+                    return Qt.alpha(control.textTint, 0.12);
+                }
+                return control.down ? Qt.darker(control.accent, 1.2) : control.hovered ? Qt.lighter(control.accent, 1.12) : control.accent;
+            }
+            return Qt.alpha(control.textTint, control.down ? 0.2 : control.hovered ? 0.12 : 0.07);
+        }
+        border.width: control.prominent ? 0 : 1
+        border.color: Qt.alpha(control.textTint, 0.14)
+        Behavior on color {
+            ColorAnimation {
+                duration: Kirigami.Units.shortDuration
+            }
+        }
+        Rectangle {
+            anchors.fill: parent
+            anchors.margins: -3
+            radius: height / 2
+            color: "transparent"
+            border.width: 2
+            border.color: Qt.alpha(control.accent, 0.6)
+            visible: control.visualFocus
+        }
+    }
+}
diff --git a/src/components/qml/ChoiceCard.qml b/src/components/qml/ChoiceCard.qml
new file mode 100644
index 0000000..8b323bf
--- /dev/null
+++ b/src/components/qml/ChoiceCard.qml
@@ -0,0 +1,117 @@
+// SPDX-FileCopyrightText: 2026 AtlasOS
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Templates as T
+import org.kde.kirigami as Kirigami
+
+/*!
+    One of a few choices, shown as a picture with a name under it: an accent
+    ring and a check mark on the chosen one. Put the picture in `preview`.
+    Cards in the same parent are exclusive.
+*/
+T.AbstractButton {
+    id: control
+
+    property string description
+    property Component preview
+
+    checkable: true
+    autoExclusive: true
+    hoverEnabled: true
+    focusPolicy: Qt.StrongFocus
+    implicitWidth: Kirigami.Units.gridUnit * 11
+    implicitHeight: column.implicitHeight
+
+    Accessible.role: Accessible.RadioButton
+    Accessible.name: control.text
+    Accessible.description: control.description
+    Accessible.checkable: true
+    Accessible.checked: control.checked
+
+    contentItem: ColumnLayout {
+        id: column
+        spacing: Kirigami.Units.smallSpacing
+
+        Item {
+            Layout.fillWidth: true
+            Layout.preferredHeight: width * 10 / 16
+
+            // The ring sits just outside the picture, as in macOS's pickers.
+            Rectangle {
+                anchors.fill: parent
+                anchors.margins: -4
+                radius: Kirigami.Units.cornerRadius * 2 + 4
+                color: "transparent"
+                border.width: 3
+                border.color: control.checked ? Kirigami.Theme.highlightColor
+                    : control.hovered || control.visualFocus ? Qt.alpha(Kirigami.Theme.highlightColor, 0.45)
+                    : "transparent"
+                Behavior on border.color {
+                    ColorAnimation {
+                        duration: Kirigami.Units.shortDuration
+                    }
+                }
+            }
+            Loader {
+                id: picture
+                anchors.fill: parent
+                sourceComponent: control.preview
+            }
+            // A hairline edge, so a light picture stands out from a light
+            // card. (The picture rounds its own corners: DesktopPreview.)
+            Rectangle {
+                anchors.fill: parent
+                radius: Kirigami.Units.cornerRadius * 2
+                color: "transparent"
+                border.width: 1
+                border.color: Qt.alpha(Kirigami.Theme.textColor, 0.15)
+            }
+        }
+
+        RowLayout {
+            Layout.alignment: Qt.AlignHCenter
+            Layout.topMargin: Kirigami.Units.smallSpacing
+            spacing: Kirigami.Units.smallSpacing
+
+            // The check mark: filled with the accent colour when chosen.
+            Rectangle {
+                implicitWidth: Math.round(Kirigami.Units.gridUnit * 0.9)
+                implicitHeight: implicitWidth
+                radius: width / 2
+                color: control.checked ? Kirigami.Theme.highlightColor : "transparent"
+                border.width: control.checked ? 0 : 1
+                border.color: Qt.alpha(Kirigami.Theme.textColor, 0.35)
+                Kirigami.Icon {
+                    anchors.centerIn: parent
+                    width: parent.width * 0.75
+                    height: width
+                    visible: control.checked
+                    source: "checkmark-symbolic"
+                    isMask: true
+                    color: Kirigami.Theme.highlightedTextColor
+                }
+            }
+            Text {
+                text: control.text
+                font.family: Kirigami.Theme.defaultFont.family
+                font.pointSize: Kirigami.Theme.defaultFont.pointSize * 1.1
+                font.weight: Font.DemiBold
+                color: Kirigami.Theme.textColor
+                textFormat: Text.PlainText
+            }
+        }
+        Text {
+            Layout.fillWidth: true
+            visible: text.length > 0
+            text: control.description
+            horizontalAlignment: Text.AlignHCenter
+            wrapMode: Text.Wrap
+            font.family: Kirigami.Theme.defaultFont.family
+            font.pointSize: Kirigami.Theme.defaultFont.pointSize * 0.9
+            color: Kirigami.Theme.disabledTextColor
+            textFormat: Text.PlainText
+        }
+    }
+}
diff --git a/src/components/qml/DesktopPreview.qml b/src/components/qml/DesktopPreview.qml
new file mode 100644
index 0000000..2727e0d
--- /dev/null
+++ b/src/components/qml/DesktopPreview.qml
@@ -0,0 +1,424 @@
+// SPDX-FileCopyrightText: 2026 AtlasOS
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import QtCore
+import QtQuick
+import QtQuick.Effects
+import org.kde.kirigami as Kirigami
+
+/*!
+    A small drawing of the AtlasOS desktop, for the choices in the setup
+    pages: the wallpaper, the top bar and the dock, in AtlasOS Light or Dark,
+    with two windows open or one of the app launchers.
+*/
+Item {
+    id: root
+
+    property bool dark: false
+    // "" shows windows; "modern" (Andromeda) or "classic" (Simple Kickoff)
+    // shows that launcher open.
+    property string launcher: ""
+    property real radius: Kirigami.Units.cornerRadius * 2
+
+    // AtlasOS Light and Dark (the colour schemes' Window, View and Header
+    // colours, and the accent).
+    readonly property color windowColor: dark ? "#211E38" : "#F3F2FA"
+    readonly property color viewColor: dark ? "#161428" : "#FFFFFF"
+    readonly property color headerColor: dark ? "#2B2748" : "#E2DFF4"
+    readonly property color textColor: dark ? "#EEECFA" : "#1B1748"
+    readonly property color accentColor: dark ? "#8A7AF4" : "#6858E2"
+    readonly property color barColor: dark ? Qt.rgba(0.13, 0.12, 0.22, 0.82) : Qt.rgba(0.97, 0.96, 0.99, 0.78)
+    readonly property color lineColor: Qt.alpha(textColor, 0.16)
+
+    readonly property real u: width / 100 // one unit: 1% of the width
+
+    // The wallpaper, with rounded corners (masked: an Image can't clip
+    // itself round).
+    Item {
+        anchors.fill: parent
+        layer.enabled: true
+        layer.effect: MultiEffect {
+            maskEnabled: true
+            maskSource: wallpaperMask
+            maskThresholdMin: 0.5
+            maskSpreadAtMin: 1
+        }
+
+        Rectangle {
+            anchors.fill: parent
+            color: root.dark ? "#1B1748" : "#C3B8FF"
+        }
+        Image {
+            anchors.fill: parent
+            // The wallpaper's dark picture for Dark, when it has one.
+            source: {
+                const file = "/1920x1080.jpg";
+                const dir = "wallpapers/Default/contents/";
+                const dark = root.dark ? StandardPaths.locate(StandardPaths.GenericDataLocation, dir + "images_dark" + file).toString() : "";
+                return dark || StandardPaths.locate(StandardPaths.GenericDataLocation, dir + "images" + file).toString();
+            }
+            sourceSize.width: 640
+            fillMode: Image.PreserveAspectCrop
+            asynchronous: true
+        }
+    }
+    Item {
+        id: wallpaperMask
+        anchors.fill: parent
+        layer.enabled: true
+        visible: false
+        Rectangle {
+            anchors.fill: parent
+            radius: root.radius
+            color: "black"
+        }
+    }
+
+    // Top bar: the launcher mark, a menu, and the clock on the right.
+    Rectangle {
+        id: topBar
+        x: root.u * 1.2
+        y: root.u * 1.2
+        width: root.width - x * 2
+        height: root.u * 4
+        radius: height / 2
+        color: root.barColor
+        Rectangle {
+            x: root.u * 1.4
+            anchors.verticalCenter: parent.verticalCenter
+            width: root.u * 1.8
+            height: width
+            radius: width / 2
+            color: root.accentColor
+        }
+        Repeater {
+            model: [6, 5, 7]
+            Rectangle {
+                required property int index
+                required property int modelData
+                x: root.u * (5 + index * 8)
+                anchors.verticalCenter: parent.verticalCenter
+                width: root.u * modelData
+                height: root.u * 0.9
+                radius: height / 2
+                color: Qt.alpha(root.textColor, 0.45)
+            }
+        }
+        Rectangle {
+            anchors.right: parent.right
+            anchors.rightMargin: root.u * 1.6
+            anchors.verticalCenter: parent.verticalCenter
+            width: root.u * 9
+            height: root.u * 0.9
+            radius: height / 2
+            color: Qt.alpha(root.textColor, 0.55)
+        }
+    }
+
+    // Two windows, when no launcher is open.
+    Repeater {
+        model: root.launcher === "" ? [
+            { x: 9, y: 11, w: 52, h: 34 },
+            { x: 41, y: 21, w: 49, h: 30 }
+        ] : []
+        Rectangle {
+            required property var modelData
+            x: root.u * modelData.x
+            y: root.u * modelData.y
+            width: root.u * modelData.w
+            height: root.u * modelData.h
+            radius: root.u * 1.4
+            color: root.windowColor
+            border.width: 1
+            border.color: root.lineColor
+            Rectangle { // title bar
+                width: parent.width
+                height: root.u * 4
+                radius: parent.radius
+                color: root.headerColor
+                Rectangle {
+                    width: parent.width
+                    height: parent.radius
+                    anchors.bottom: parent.bottom
+                    color: parent.color
+                }
+                Row {
+                    anchors.right: parent.right
+                    anchors.rightMargin: root.u * 1.4
+                    anchors.verticalCenter: parent.verticalCenter
+                    spacing: root.u * 0.8
+                    Repeater {
+                        model: 3
+                        Rectangle {
+                            width: root.u * 1.3
+                            height: width
+                            radius: width / 2
+                            color: Qt.alpha(root.textColor, 0.35)
+                        }
+                    }
+                }
+            }
+            Rectangle { // sidebar
+                x: root.u * 1.4
+                y: root.u * 5.4
+                width: parent.width * 0.26
+                height: parent.height - y - root.u * 1.4
+                radius: root.u * 0.8
+                color: Qt.alpha(root.textColor, 0.06)
+                Rectangle {
+                    x: root.u * 0.8
+                    y: root.u * 1
+                    width: parent.width - root.u * 1.6
+                    height: root.u * 2
+                    radius: root.u * 0.6
+                    color: root.accentColor
+                }
+            }
+            Column { // text lines
+                x: parent.width * 0.26 + root.u * 3.4
+                y: root.u * 6.4
+                spacing: root.u * 1.6
+                Repeater {
+                    model: [0.9, 0.7, 0.8, 0.5]
+                    Rectangle {
+                        required property real modelData
+                        width: (parent.parent.width * 0.74 - root.u * 5) * modelData
+                        height: root.u * 1
+                        radius: height / 2
+                        color: Qt.alpha(root.textColor, 0.22)
+                    }
+                }
+            }
+        }
+    }
+
+    // The dock: the launcher, a separator and the apps, centred. Running apps
+    // have a short underline, the active one in the accent colour.
+    Rectangle {
+        id: dock
+        anchors.horizontalCenter: parent.horizontalCenter
+        anchors.bottom: parent.bottom
+        anchors.bottomMargin: root.u * 1.6
+        width: dockRow.width + root.u * 2.4
+        height: root.u * 7
+        radius: root.u * 2.2
+        color: root.barColor
+        Row {
+            id: dockRow
+            anchors.centerIn: parent
+            spacing: root.u * 1.1
+            Repeater {
+                model: [root.accentColor, "transparent", "#F25F2C", "#3D8BF2", "#4A4766", "#33B8A0", "#8E5CE8"]
+                Item {
+                    required property color modelData
+                    required property int index
+                    width: index === 1 ? root.u * 0.3 : root.u * 4.8
+                    height: root.u * 4.8
+                    Rectangle {
+                        anchors.fill: parent
+                        visible: parent.index !== 1
+                        radius: root.u * 1.2
+                        color: parent.modelData
+                        // The launcher's grid mark.
+                        Grid {
+                            anchors.centerIn: parent
+                            visible: parent.parent.index === 0
+                            columns: 2
+                            spacing: root.u * 0.5
+                            Repeater {
+                                model: 4
+                                Rectangle {
+                                    width: root.u * 1.1
+                                    height: width
+                                    radius: root.u * 0.3
+                                    color: "white"
+                                }
+                            }
+                        }
+                    }
+                    Rectangle { // separator
+                        visible: parent.index === 1
+                        anchors.centerIn: parent
+                        width: root.u * 0.25
+                        height: parent.height * 0.8
+                        color: root.lineColor
+                    }
+                    Rectangle { // running: the file manager (active) and the browser
+                        visible: parent.index === 2 || parent.index === 3
+                        anchors.horizontalCenter: parent.horizontalCenter
+                        anchors.top: parent.bottom
+                        anchors.topMargin: root.u * 0.45
+                        width: root.u * 1.7
+                        height: Math.max(1, root.u * 0.35)
+                        radius: height / 2
+                        color: parent.index === 2 ? root.accentColor : Qt.alpha(root.textColor, 0.45)
+                    }
+                }
+            }
+        }
+    }
+
+    // Modern (Andromeda): centred over the dock, a greeting, favourites in a
+    // grid, and the search bar at the bottom.
+    Rectangle {
+        visible: root.launcher === "modern"
+        anchors.horizontalCenter: parent.horizontalCenter
+        anchors.bottom: dock.top
+        anchors.bottomMargin: root.u * 1.4
+        width: root.u * 50
+        height: root.height - topBar.height - dock.height - root.u * 6.2
+        radius: root.u * 2.2
+        color: root.windowColor
+        border.width: 1
+        border.color: root.lineColor
+        Rectangle { // avatar
+            x: root.u * 3
+            y: root.u * 2.6
+            width: root.u * 5
+            height: width
+            radius: width / 2
+            gradient: Gradient {
+                GradientStop { position: 0; color: "#6252DD" }
+                GradientStop { position: 1; color: "#C3B8FF" }
+            }
+        }
+        Rectangle { // "Hi, name"
+            x: root.u * 9.6
+            y: root.u * 4.6
+            width: root.u * 12
+            height: root.u * 1.2
+            radius: height / 2
+            color: Qt.alpha(root.textColor, 0.55)
+        }
+        Grid {
+            x: root.u * 3
+            y: root.u * 10.4
+            columns: 6
+            columnSpacing: (parent.width - root.u * 6 - 6 * root.u * 5.2) / 5
+            rowSpacing: root.u * 2.6
+            Repeater {
+                model: ["#F25F2C", "#3D8BF2", "#4A4766", "#33B8A0", "#8E5CE8", "#E8B22C", "#5CC46A", "#E85C8E", "#4AC0E8", "#9A98AC", "#6858E2", "#F2884A"]
+                Rectangle {
+                    required property color modelData
+                    width: root.u * 5.2
+                    height: width
+                    radius: root.u * 1.3
+                    color: modelData
+                }
+            }
+        }
+        Rectangle { // search
+            anchors.bottom: parent.bottom
+            anchors.bottomMargin: root.u * 2.2
+            anchors.horizontalCenter: parent.horizontalCenter
+            width: parent.width - root.u * 6
+            height: root.u * 4
+            radius: height / 2
+            color: root.viewColor
+            border.width: 1
+            border.color: root.lineColor
+            Rectangle {
+                x: root.u * 1.6
+                anchors.verticalCenter: parent.verticalCenter
+                width: root.u * 1.6
+                height: width
+                radius: width / 2
+                color: "transparent"
+                border.width: Math.max(1, root.u * 0.3)
+                border.color: Qt.alpha(root.textColor, 0.45)
+            }
+        }
+    }
+
+    // Classic (Simple Kickoff): a menu opening from the launcher, with the
+    // search field on top, a list of apps, and the user and power at the
+    // bottom.
+    Rectangle {
+        visible: root.launcher === "classic"
+        x: dock.x
+        anchors.bottom: dock.top
+        anchors.bottomMargin: root.u * 1.4
+        width: root.u * 32
+        height: root.height - topBar.height - dock.height - root.u * 6.2
+        radius: root.u * 1.6
+        color: root.windowColor
+        border.width: 1
+        border.color: root.lineColor
+        Rectangle { // search
+            x: root.u * 1.8
+            y: root.u * 1.8
+            width: parent.width - root.u * 3.6
+            height: root.u * 3.6
+            radius: root.u * 0.9
+            color: root.viewColor
+            border.width: 1
+            border.color: root.lineColor
+        }
+        Column {
+            x: root.u * 1.8
+            y: root.u * 7.4
+            spacing: root.u * 1.25
+            Repeater {
+                model: [["#F25F2C", 0.55], ["#3D8BF2", 0.42], ["#4A4766", 0.5], ["#33B8A0", 0.38], ["#8E5CE8", 0.6], ["#E8B22C", 0.45], ["#5CC46A", 0.35]]
+                Row {
+                    required property var modelData
+                    required property int index
+                    spacing: root.u * 1.4
+                    Rectangle {
+                        width: root.u * 3
+                        height: width
+                        radius: root.u * 0.8
+                        color: parent.modelData[0]
+                    }
+                    Rectangle {
+                        anchors.verticalCenter: parent.verticalCenter
+                        width: root.u * 32 * parent.modelData[1]
+                        height: root.u * 1
+                        radius: height / 2
+                        color: Qt.alpha(root.textColor, 0.35)
+                    }
+                }
+            }
+        }
+        Rectangle { // footer
+            anchors.bottom: parent.bottom
+            width: parent.width
+            height: root.u * 5
+            radius: parent.radius
+            color: root.headerColor
+            Rectangle {
+                width: parent.width
+                height: parent.radius
+                color: parent.color
+            }
+            Rectangle {
+                x: root.u * 1.8
+                anchors.verticalCenter: parent.verticalCenter
+                width: root.u * 2.8
+                height: width
+                radius: width / 2
+                gradient: Gradient {
+                    GradientStop { position: 0; color: "#6252DD" }
+                    GradientStop { position: 1; color: "#C3B8FF" }
+                }
+            }
+            Row {
+                anchors.right: parent.right
+                anchors.rightMargin: root.u * 1.8
+                anchors.verticalCenter: parent.verticalCenter
+                spacing: root.u * 1.2
+                Repeater {
+                    model: 2
+                    Rectangle {
+                        width: root.u * 2
+                        height: width
+                        radius: width / 2
+                        color: "transparent"
+                        border.width: Math.max(1, root.u * 0.3)
+                        border.color: Qt.alpha(root.textColor, 0.45)
+                    }
+                }
+            }
+        }
+    }
+}
