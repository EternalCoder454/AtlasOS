# Telamon OS's default pinned apps for Telamon Launcher, in the dock's order: one
# desktop file id per line, or preferred://browser, preferred://filemanager,
# preferred://terminal. Apps that aren't installed are skipped (no browser is
# preinstalled). Replaces the package's list (build.sh copies system_files after
# apps.sh). A user's own list is ~/.config/telamon-launcher/pinned.list.
preferred://browser
net.eterneon.telamon.explorer.desktop
net.eterneon.telamon.store.desktop
org.kde.discover.desktop
net.eterneon.telamon.settings.desktop
com.mitchellh.ghostty.desktop
net.eterneon.telamon.notepad.desktop
net.eterneon.telamon.monitor.desktop
