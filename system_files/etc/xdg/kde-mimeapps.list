# No browser is set here (the installer's app step offers one). Atlas Notepad
# opens text and source files,
# Gwenview opens images, Okular opens PDFs, and Haruna opens video and audio.
# Ahead of Fedora's lists, which name Firefox and KWrite, and of a browser's
# own claim on PDFs and images.
[Default Applications]
text/plain=net.eterneon.atlas.notepad.desktop
text/markdown=net.eterneon.atlas.notepad.desktop
text/x-readme=net.eterneon.atlas.notepad.desktop
text/x-log=net.eterneon.atlas.notepad.desktop
text/csv=net.eterneon.atlas.notepad.desktop
text/x-csrc=net.eterneon.atlas.notepad.desktop
text/x-chdr=net.eterneon.atlas.notepad.desktop
text/x-c++src=net.eterneon.atlas.notepad.desktop
text/x-c++hdr=net.eterneon.atlas.notepad.desktop
text/x-python=net.eterneon.atlas.notepad.desktop
text/x-python3=net.eterneon.atlas.notepad.desktop
text/rust=net.eterneon.atlas.notepad.desktop
text/x-go=net.eterneon.atlas.notepad.desktop
text/x-java=net.eterneon.atlas.notepad.desktop
text/javascript=net.eterneon.atlas.notepad.desktop
application/javascript=net.eterneon.atlas.notepad.desktop
text/css=net.eterneon.atlas.notepad.desktop
text/x-cmake=net.eterneon.atlas.notepad.desktop
text/x-makefile=net.eterneon.atlas.notepad.desktop
text/x-patch=net.eterneon.atlas.notepad.desktop
text/x-diff=net.eterneon.atlas.notepad.desktop
application/json=net.eterneon.atlas.notepad.desktop
application/xml=net.eterneon.atlas.notepad.desktop
text/xml=net.eterneon.atlas.notepad.desktop
application/x-yaml=net.eterneon.atlas.notepad.desktop
application/yaml=net.eterneon.atlas.notepad.desktop
application/toml=net.eterneon.atlas.notepad.desktop
application/x-shellscript=net.eterneon.atlas.notepad.desktop
application/x-desktop=net.eterneon.atlas.notepad.desktop
image/jpeg=org.kde.gwenview.desktop
image/png=org.kde.gwenview.desktop
image/gif=org.kde.gwenview.desktop
image/webp=org.kde.gwenview.desktop
image/avif=org.kde.gwenview.desktop
image/heif=org.kde.gwenview.desktop
image/heic=org.kde.gwenview.desktop
image/jxl=org.kde.gwenview.desktop
image/bmp=org.kde.gwenview.desktop
image/tiff=org.kde.gwenview.desktop
image/svg+xml=org.kde.gwenview.desktop
image/x-icon=org.kde.gwenview.desktop
image/x-xcf=org.kde.gwenview.desktop
image/x-psd=org.kde.gwenview.desktop
application/pdf=org.kde.okular.desktop
video/mp4=org.kde.haruna.desktop
video/x-matroska=org.kde.haruna.desktop
video/webm=org.kde.haruna.desktop
video/mpeg=org.kde.haruna.desktop
video/ogg=org.kde.haruna.desktop
video/quicktime=org.kde.haruna.desktop
video/vnd.avi=org.kde.haruna.desktop
video/x-msvideo=org.kde.haruna.desktop
video/mp2t=org.kde.haruna.desktop
video/x-ms-wmv=org.kde.haruna.desktop
audio/mpeg=org.kde.haruna.desktop
audio/flac=org.kde.haruna.desktop
audio/ogg=org.kde.haruna.desktop
audio/vnd.wave=org.kde.haruna.desktop
audio/x-wav=org.kde.haruna.desktop
audio/mp4=org.kde.haruna.desktop
audio/aac=org.kde.haruna.desktop
audio/webm=org.kde.haruna.desktop
audio/x-matroska=org.kde.haruna.desktop
audio/x-mpegurl=org.kde.haruna.desktop

# Notepad itself only claims plain text and Markdown. These put it in Open
# With for the source and data types above too.
[Added Associations]
text/plain=net.eterneon.atlas.notepad.desktop;
text/markdown=net.eterneon.atlas.notepad.desktop;
text/x-readme=net.eterneon.atlas.notepad.desktop;
