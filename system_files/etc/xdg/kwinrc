# Windows 11-style title bars: the window menu (app icon) on the left;
# minimize, maximize and close on the right.
[org.kde.kdecoration2]
ButtonsOnLeft=M
ButtonsOnRight=IAX

# Fedora turns on the on-screen keyboard (plasma-keyboard, about 270 MB of
# RAM). Off by default, like Windows on a non-touch PC; System Settings >
# Keyboard > Virtual Keyboard turns it back on.
[Wayland]
InputMethod[$e]=
VirtualKeyboardEnabled=false

# Windows 11's acrylic for every blurred surface (the dock, the menu bar,
# menus, popups): a strong blur with a little noise over it.
[Effect-blur]
BlurStrength=13
NoiseStrength=4
