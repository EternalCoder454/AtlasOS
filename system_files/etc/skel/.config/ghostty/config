# Ghostty's settings on Telamon OS. New users get this file; it is yours to edit
# (https://ghostty.org/docs/config). The Telamon OS themes are in
# /usr/share/ghostty/themes and follow the system's light and dark setting.
theme = light:Telamon Light,dark:Telamon Dark
font-family = JetBrains Mono
font-size = 11
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
cursor-style = bar
