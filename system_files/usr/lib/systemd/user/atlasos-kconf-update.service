# Runs Telamon OS's settings updates (kconf_update) at the start of each Plasma
# session, before KWin and the shell read the settings. kded6 runs
# kconf_update too, but it only picks a .upd file whose mtime differs from the
# one recorded, and ostree gives every file in /usr mtime 0, the same as "never
# recorded", so it skips ours. Naming the file makes kconf_update read it
# anyway; each Id still runs once per user (recorded in kconf_updaterc).
# Login waits for it (Before=), so a hung script is killed after 30 s and the
# session starts anyway; a failure never stops the session (no Requires=).
[Unit]
Description=Telamon OS settings updates for this user
ConditionPathExists=/usr/share/kconf_update/atlasos.upd
Before=plasma-kwin_wayland.service plasma-plasmashell.service plasma-kded6.service

[Service]
Type=oneshot
TimeoutStartSec=30
ExecStart=/usr/libexec/kf6/kconf_update /usr/share/kconf_update/atlasos.upd
# Sandbox: the little that is safe for a user service without a mount
# namespace (those options need user namespaces, which not every system has).
# It runs the user's own tools on the user's own files; none of them needs a
# new privilege.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=plasma-core.target
