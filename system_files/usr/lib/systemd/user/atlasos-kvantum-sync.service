[Unit]
Description=Pick the Telamon OS Kvantum theme (light/dark, translucent/solid)
# Plasma writes kdeglobals several times in a row on a theme switch; each write
# starts this, and the default start limit would stop the watch for the session.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/libexec/telamon/kvantum-sync
# Sandbox: the little that is safe for a user service without a mount
# namespace (those options need user namespaces, which not every system has).
# It runs the user's own tools on the user's own files; none of them needs a
# new privilege.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
