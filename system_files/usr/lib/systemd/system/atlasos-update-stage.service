[Unit]
Description=Download and stage the next AtlasOS update
Documentation=https://github.com/EternalCoder454/AtlasOS
# Only on an image-based boot, only with a network, and not on metered ones
# (the condition script). `bootc upgrade` (`rpm-ostree upgrade` on a system
# with local rpm-ostree changes: see update-stage) downloads the new image and
# stages it; it never reboots. A staged update is used at the next shutdown or
# reboot.
ConditionPathExists=/run/ostree-booted
After=network-online.target
Wants=network-online.target
# A download that failed with a network error (update-stage exits 75) is
# tried again in 15 minutes rather than at the next timer run 6 hours later,
# at most 4 tries in 3 hours; other failures (a full disk) wait for the timer.
# A skip by the condition script is not a failure.
StartLimitIntervalSec=3h
StartLimitBurst=4

[Service]
Type=oneshot
ExecCondition=/usr/libexec/atlasos/update-stage-condition
ExecStart=/usr/libexec/atlasos/update-stage
# Background work: out of the way of whatever the user is doing.
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
TimeoutStartSec=2h
RestartForceExitStatus=75
RestartSec=15min
# Sandbox. bootc and rpm-ostree write /sysroot, /boot, /etc, /var and /run,
# remount /sysroot in mount namespaces, and check out images with their
# setuid files, devices and immutable bits: so no ProtectSystem,
# RestrictNamespaces, RestrictSUIDSGID, PrivateDevices or
# MemoryDenyWriteExecute, and the capabilities that ostree uses stay
# (CAP_SYS_PTRACE too: bootc reads /proc/1/ns/mnt to join the host mounts).
PrivateTmp=yes
# update-stage keeps the download's output here (/run/atlasos-update-stage)
RuntimeDirectory=atlasos-update-stage
RuntimeDirectoryMode=0700
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_TIME CAP_SYS_BOOT CAP_SYS_RAWIO CAP_BPF CAP_PERFMON CAP_SYS_TTY_CONFIG CAP_WAKE_ALARM CAP_BLOCK_SUSPEND CAP_SYSLOG CAP_AUDIT_CONTROL CAP_AUDIT_READ CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_NET_BROADCAST CAP_SYS_PACCT CAP_LEASE CAP_MAC_OVERRIDE CAP_CHECKPOINT_RESTORE
