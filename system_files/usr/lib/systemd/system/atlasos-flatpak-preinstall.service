[Unit]
Description=Install Telamon OS's preinstalled Flatpak apps
Documentation=https://github.com/EternalCoder454/AtlasOS man:flatpak-preinstall(1)
# Started by atlasos-flatpak-preinstall.timer a few minutes after boot, never
# as part of the boot itself: it is not ordered before multi-user.target,
# graphical.target or the display manager, so it cannot hold up boot or login.
ConditionPathExists=/usr/share/flatpak/preinstall.d
After=network-online.target flatpak-add-fedora-repos.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/telamon/flatpak-preinstall
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
TimeoutStartSec=1h
# Sandbox. Flatpak writes only its system installation, our stamp and its
# download cache; its triggers run in bubblewrap, which needs mount and other
# namespaces as root (so no RestrictNamespaces, and CAP_SYS_ADMIN,
# CAP_NET_ADMIN and CAP_SYS_CHROOT stay; the capabilities below it never uses
# go).
# StateDirectory makes /var/lib/atlasos (it may not exist yet on a first boot)
# and opens it; a ReadWritePaths entry that doesn't exist would fail the unit.
ProtectSystem=strict
StateDirectory=atlasos
ReadWritePaths=-/var/lib/flatpak -/var/cache/flatpak /var/tmp
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ProtectHostname=yes
UMask=0022
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_BOOT CAP_SYS_RAWIO CAP_SYS_TIME CAP_BPF CAP_PERFMON CAP_SYSLOG CAP_AUDIT_CONTROL CAP_AUDIT_READ CAP_AUDIT_WRITE CAP_MAC_ADMIN CAP_MAC_OVERRIDE CAP_SYS_TTY_CONFIG CAP_WAKE_ALARM CAP_BLOCK_SUSPEND CAP_SYS_PACCT CAP_LEASE CAP_IPC_LOCK CAP_SYS_NICE CAP_SYS_RESOURCE CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_NET_BROADCAST CAP_CHECKPOINT_RESTORE
# Home is hidden, so GLib's dconf (it has nothing to save here) stays off
Environment=GSETTINGS_BACKEND=memory
