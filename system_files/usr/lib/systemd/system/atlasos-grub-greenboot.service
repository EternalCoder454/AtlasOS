[Unit]
Description=Add greenboot's boot counter to GRUB (installs made before it), and clear it on rollback
Documentation=https://github.com/EternalCoder454/AtlasOS#boot-health-checks-and-rollback
ConditionPathExists=/run/ostree-booted
ConditionPathExists=/usr/lib/bootupd/grub2-static/configs.d/08_greenboot.cfg
ConditionPathIsDirectory=/boot/grub2
RequiresMountsFor=/boot
After=ostree-remount.service bootloader-update.service
# Stops (ExecStop) before these at shutdown, while the rollback is still queued.
After=ostree-finalize-staged.service greenboot-set-rollback-trigger.service
Before=greenboot-healthcheck.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/atlasos/grub-greenboot start
ExecStop=/usr/libexec/atlasos/grub-greenboot stop
# Like bootloader-update.service: /boot is made writable in a private mount
# namespace, so it stays read-only for everything else.
MountFlags=slave
PrivateNetwork=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
