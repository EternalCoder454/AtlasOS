[Unit]
Description=Add greenboot's boot counter to GRUB (installs made before it), and clear it on rollback
Documentation=https://github.com/EternalCoder454/AtlasOS#boot-health-checks-and-rollback
ConditionPathExists=/run/ostree-booted
ConditionPathExists=/usr/lib/bootupd/grub2-static/configs.d/08_greenboot.cfg
ConditionPathIsDirectory=/boot/grub2
RequiresMountsFor=/boot
After=ostree-remount.service bootloader-update.service
# Stops (ExecStop) before these at shutdown, while the rollback is still queued.
After=ostree-finalize-staged.service greenboot-set-rollback-trigger.service
Before=greenboot-healthcheck.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/telamon/grub-greenboot start
ExecStop=/usr/libexec/telamon/grub-greenboot stop
# Like bootloader-update.service: /boot is made writable in a private mount
# namespace, so it stays read-only for everything else.
MountFlags=slave
PrivateNetwork=yes
ProtectHome=yes
# The rest of the sandbox: it writes only /boot/grub2 and /run, reads bootc's
# status (CAP_SYS_PTRACE: bootc reads /proc/1/ns/mnt), and logs. No
# ProtectSystem: its own remount of /boot has to work.
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=~user net pid uts cgroup ipc
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_CHOWN

[Install]
WantedBy=multi-user.target
