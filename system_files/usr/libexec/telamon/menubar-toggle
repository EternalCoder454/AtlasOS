#!/bin/bash
# Shows the Telamon OS menu bar (the islands along the top) over the windows, or
# lets it hide again. Normally it hides while a window covers it, so
# maximized and fullscreen apps get the whole screen. Shown, it stays on top
# of them and they keep their size: it covers their top edge instead of
# pushing them down. Meta+M runs this
# (/usr/share/kglobalaccel/org.telamon.menubar-toggle.desktop).
set -euo pipefail

# Only the islands (floating top panels as wide as what they hold), so a top
# panel the user made keeps its own setting. Plasma's script API sets
# "windowsgobelow" but reads it back as "none" (its getter has no case for
# it), so the state is told by "dodgewindows" alone: any island hiding means
# show them all.
state=$(qdbus-qt6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript '
var bar = panels().filter(function (p) {
    return p.location == "top" && p.floating && p.lengthMode == "fit";
});
var show = bar.some(function (p) { return p.hiding == "dodgewindows"; });
bar.forEach(function (p) { p.hiding = show ? "windowsgobelow" : "dodgewindows"; });
print(bar.length == 0 ? "none" : show ? "shown" : "hides");
') || {
	echo "menubar-toggle: Plasma's shell is not reachable" >&2
	exit 1
}

case $state in
shown) text="Menu bar shown" icon=window-pin ;;
hides) text="Menu bar hides under windows" icon=window-unpin ;;
none) text="There is no menu bar to show" icon=dialog-information ;;
*)
	# The script failed inside Plasma, which prints the error and exits 0
	echo "menubar-toggle: Plasma could not change the menu bar: $state" >&2
	text="Could not change the menu bar" icon=dialog-error
	;;
esac
qdbus-qt6 org.kde.plasmashell /org/kde/osdService org.kde.osdService.showText "$icon" "$text" >/dev/null || true
[ "$icon" != dialog-error ]
