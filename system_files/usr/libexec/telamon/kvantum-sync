#!/bin/sh
# Writes the Telamon OS Kvantum theme into ~/.config/Kvantum/kvantum.kvconfig:
# dark when kdeglobals' ColorScheme contains "Dark", Solid when telamonrc
# [Appearance] Transparency is false (~/.config/telamonrc over /etc/xdg/telamonrc,
# default true; the switch of Telamon.Ui 1.x lived in atlasrc, which is read
# when there is no telamonrc yet).
# The colour scheme is read the way Plasma's session reads it:
# ~/.config/kdeglobals, then ~/.config/kdedefaults/kdeglobals (where applying a
# Global Theme writes it), then /etc/xdg. A theme the user picked that isn't
# one of ours is left alone.
# Writes only when the value changes, so running it twice does nothing.
#
# It also keeps GTK in step (sync_gtk). Plasma's gtkconfig (kded) sets GTK's
# dark preference, icon theme and gsettings colour scheme when kdeglobals
# notifies a change of [General] ColorScheme or [Icons] Theme, and once when
# kded starts. Applying a Global Theme writes those two keys into
# kdedefaults, which notifies nothing, so GTK (Brave's dark mode, GTK dialogs)
# kept the theme the session started with. When GTK disagrees, this sends
# gtkconfig that notification itself, so it does the work as usual.
set -eu

cfg=${XDG_CONFIG_HOME:-$HOME/.config}
etc=${TELAMON_ETC_XDG:-${ATLAS_ETC_XDG:-/etc/xdg}}

# Reads one key from that one file. kreadconfig6 would also look through
# XDG_CONFIG_DIRS, which names /etc/xdg (the Light scheme) and, only once
# Plasma has started, the Global Theme's defaults before it: a user whose
# kdeglobals has no ColorScheme (the Global Theme's is in kdedefaults) was read
# as Light at login, so Kvantum, and with it the Qt apps and the portal's
# colour-scheme, came up Light on a Dark desktop.
get() { # file group key
	[ -f "$1" ] || return 0
	awk -v g="$2" -v k="$3" '
		/^\[/ { in_g = ($0 == "[" g "]"); next }
		in_g {
			i = index($0, "=")
			if (i && substr($0, 1, i - 1) == k) { v = substr($0, i + 1); sub(/^[ \t]+/, "", v); sub(/[ \t\r]+$/, "", v); r = v }
		}
		END { if (r != "") print r }
	' "$1" 2>/dev/null || true
}

sync_theme() {
	scheme=$(get "$cfg/kdeglobals" General ColorScheme)
	[ -n "$scheme" ] || scheme=$(get "$cfg/kdedefaults/kdeglobals" General ColorScheme)
	[ -n "$scheme" ] || scheme=$(get "$etc/kdeglobals" General ColorScheme)
	# The framework copies atlasrc to telamonrc the first time an app of 2.0
	# runs; until then the old file is the user's choice.
	if [ -f "$cfg/telamonrc" ]; then
		transp=$(get "$cfg/telamonrc" Appearance Transparency)
	else
		transp=$(get "$cfg/atlasrc" Appearance Transparency)
	fi
	[ -n "$transp" ] || transp=$(get "$etc/telamonrc" Appearance Transparency)

	case $scheme in *Dark*) name=TelamonDark ;; *) name=Telamon ;; esac
	case $transp in false | 0 | no | off) name=${name}Solid ;; esac

	file=$cfg/Kvantum/kvantum.kvconfig
	cur=$(get "$file" General theme)
	case $cur in
	"" | Telamon | TelamonDark | TelamonSolid | TelamonDarkSolid) ;;
	# What the theme was called before Telamon (the rename's migration
	# changes it too; this is for a save that came after it).
	AtlasOS | AtlasOSDark | AtlasOSSolid | AtlasOSDarkSolid) ;;
	*) return 0 ;;
	esac
	[ "$cur" = "$name" ] && return 0
	mkdir -p "$cfg/Kvantum"
	kwriteconfig6 --file "$file" --group General --key theme "$name"
}

# GTK's settings.ini value for a key, or empty.
gtk_get() { # key
	sed -n "s/^$1=//p" "$cfg/gtk-3.0/settings.ini" 2>/dev/null | tail -n 1
}

# A key's bytes as busctl wants an "ay": the count, then each byte.
bytes() {
	printf '%s ' "${#1}"
	printf '%s' "$1" | od -An -tu1 | tr -s ' \n' '  '
}

sync_gtk() {
	scheme=$(get "$cfg/kdeglobals" General ColorScheme)
	[ -n "$scheme" ] || scheme=$(get "$cfg/kdedefaults/kdeglobals" General ColorScheme)
	[ -n "$scheme" ] || scheme=$(get "$etc/kdeglobals" General ColorScheme)
	icons=$(get "$cfg/kdeglobals" Icons Theme)
	[ -n "$icons" ] || icons=$(get "$cfg/kdedefaults/kdeglobals" Icons Theme)
	[ -n "$icons" ] || icons=$(get "$etc/kdeglobals" Icons Theme)
	case $scheme in *Dark*) dark=true ;; *) dark=false ;; esac

	# No GTK theme named means GTK's own Adwaita, which is light: name
	# Breeze, which gtkconfig colours from the scheme (colors.css). A theme
	# the user picked stays.
	named=
	for d in gtk-3.0 gtk-4.0; do
		if [ -z "$(sed -n 's/^gtk-theme-name=//p' "$cfg/$d/settings.ini" 2>/dev/null)" ]; then
			mkdir -p "$cfg/$d"
			kwriteconfig6 --file "$cfg/$d/settings.ini" --group Settings --key gtk-theme-name Breeze
			named=1
		fi
	done
	# gtkconfig reads the theme name only when it starts (then applies all of
	# GTK's settings): reload the module so a newly named theme reaches
	# gsettings and xsettingsd too. kded not running is fine.
	if [ -n "$named" ]; then
		busctl --user call org.kde.kded6 /kded org.kde.kded6 unloadModule s gtkconfig >/dev/null 2>&1 || true
		busctl --user call org.kde.kded6 /kded org.kde.kded6 loadModule s gtkconfig >/dev/null 2>&1 || true
		return 0
	fi

	[ "$(gtk_get gtk-application-prefer-dark-theme)" = "$dark" ] &&
		{ [ -z "$icons" ] || [ "$(gtk_get gtk-icon-theme-name)" = "$icons" ]; } && return 0
	# kded's gtkconfig listens on /kdeglobals; nobody listening is fine.
	# shellcheck disable=SC2046 # the byte lists are meant to split
	busctl --user emit /kdeglobals org.kde.kconfig.notify ConfigChanged 'a{saay}' 2 \
		General 1 $(bytes ColorScheme) Icons 1 $(bytes Theme) 2>/dev/null || true
}

# The path unit (which sets TRIGGER_UNIT) starts this on any save directly in
# ~/.config. A stamp in the runtime folder, touched before each read, tells
# whether one of the files it reads was saved, made or deleted since
# (it holds which of them existed): other saves cost only this check. A theme
# switch saves kdeglobals several times in a row, so it waits a second for them
# to settle, and since a save that lands while this runs starts nothing new, it
# reads again (twice at most) when one did.
stamp=
[ -z "${XDG_RUNTIME_DIR:-}" ] || stamp=$XDG_RUNTIME_DIR/atlasos-kvantum-sync.stamp
present() {
	for f in "$cfg/kdeglobals" "$cfg/kdedefaults/kdeglobals" "$cfg/telamonrc" "$cfg/atlasrc"; do
		if [ -e "$f" ]; then printf 1; else printf 0; fi
	done
}
changed() {
	for f in "$cfg/kdeglobals" "$cfg/kdedefaults/kdeglobals" "$cfg/telamonrc" "$cfg/atlasrc"; do
		[ "$f" -nt "$stamp" ] && return 0
	done
	old=
	read -r old <"$stamp" 2>/dev/null || true
	[ "$old" != "$(present)" ]
}
triggered=
[ -z "${TRIGGER_UNIT:-}" ] || [ -z "$stamp" ] || triggered=1
if [ -n "$triggered" ]; then
	changed || exit 0
	sleep 1
fi
n=0
while :; do
	# A stamp that can't be written (a full runtime folder) only costs the
	# next check its shortcut.
	[ -z "$stamp" ] || present >"$stamp" 2>/dev/null || true
	sync_theme
	sync_gtk
	n=$((n + 1))
	if [ -z "$triggered" ] || [ "$n" -ge 3 ] || ! changed; then
		break
	fi
	sleep 1
done
