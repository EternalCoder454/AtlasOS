#!/usr/bin/bash
# Sets, changes or removes the PIN for the login and lock screens (see DEV.md,
# "PIN sign-in"). The launcher entry "Set Up PIN" runs it. With --first-login
# (the XDG autostart atlasos-pin-setup.desktop) it first asks, once per user,
# whether they want one. The PIN goes to pin-admin on stdin through pkexec,
# which asks for the user's own password.
set -u

state="${XDG_STATE_HOME:-$HOME/.local/state}/atlasos"
done_file="$state/pin-setup-done"
admin=/usr/libexec/telamon/pin-admin
title="PIN"

mark_done() {
	mkdir -p "$state" && : >"$done_file"
}

# A first-login question left without an answer (closed, or no notification
# service yet) comes back at the next login, three times at most.
unanswered() {
	local tries="$state/pin-setup-tries" n
	n=$(cat "$tries" 2>/dev/null) || n=0
	case $n in '' | *[!0-9]*) n=0 ;; esac
	n=$((n + 1))
	if [ "$n" -ge 3 ]; then
		mark_done
	else
		mkdir -p "$state" && echo "$n" >"$tries"
	fi
}

if [ "${1:-}" = --first-login ]; then
	# The wizard's own session, and the login before the wizard has finished.
	case $(id -un) in telamon-setup | atlas-setup) exit 0 ;; esac
	[ -e /etc/plasma-setup-done ] || exit 0
	[ -e "$done_file" ] && exit 0
	current=$("$admin" status 2>/dev/null) || exit 0
	if [ "$current" != none ]; then
		mark_done
		exit 0
	fi
	# Let the desktop finish appearing, and let the fingerprint question go
	# first, however long it waits for an answer: never two questions at once.
	# Then the enrolling it may have opened (System Settings, or a dialog),
	# for 10 minutes at most: Settings left open all day doesn't hold this.
	sleep 8
	while pgrep -u "$(id -u)" -f '/usr/libexec/telamon/fingerprint-setup' >/dev/null; do
		sleep 3
	done
	for _ in $(seq 200); do
		pgrep -u "$(id -u)" -x kdialog >/dev/null ||
			pgrep -u "$(id -u)" -x systemsettings >/dev/null || break
		sleep 3
	done
	# A notification with buttons rather than a dialog: it doesn't take over
	# the new desktop, and nothing heavy waits in the background. It stays
	# until answered. notify-send prints the chosen action, or nothing if the
	# notification was closed; its errors go to the journal.
	answer=$(notify-send --app-name="Telamon OS" --icon=preferences-desktop-user-password \
		--action=setup="Set Up PIN" --action=later="Not Now" \
		--expire-time=0 --wait \
		"Sign in faster with a PIN" \
		"Your password keeps working. You can also do this later: open Set Up PIN from the launcher.")
	case $answer in
	setup) mark_done ;;
	later)
		mark_done
		exit 0
		;;
	*)
		unanswered
		exit 0
		;;
	esac
fi

current=$("$admin" status 2>/dev/null) || {
	kdialog --title "$title" --error "The PIN service isn't running. Restart the computer and try again."
	exit 1
}

if [ "$current" = retired ]; then
	# Too many wrong PINs over its life: the daemon turned it off.
	kdialog --title "$title" --yesno "Your PIN was turned off because too many wrong PINs were typed over time. Your password still works.\n\nSet a new PIN?" \
		--yes-label "Set New PIN" --no-label "Not Now" || exit 0
elif [ "$current" != none ]; then
	kdialog --title "$title" --yesnocancel \
		"You have a PIN set up.\n\nChange it, or remove it and use only your password?" \
		--yes-label "Change PIN" --no-label "Remove PIN" --cancel-label "Cancel"
	case $? in
	0) ;;
	1)
		if out=$(pkexec "$admin" remove 2>&1); then
			kdialog --title "$title" --msgbox "PIN removed. Sign in with your password."
		else
			kdialog --title "$title" --error "Couldn't remove the PIN.\n\n$out"
		fi
		exit 0
		;;
	*) exit 0 ;;
	esac
fi

while :; do
	pin=$(kdialog --title "$title" --password "Choose a PIN of 4 to 8 digits.\n\nIt works at the login screen and the lock screen only.\n\nA PIN is easier to guess than a password if someone gets at the disk: don't reuse a bank-card PIN, and a longer PIN is safer.") || exit 0
	again=$(kdialog --title "$title" --password "Type the PIN again.") || exit 0
	if [ "$pin" != "$again" ]; then
		kdialog --title "$title" --sorry "The two PINs weren't the same. Try again."
		continue
	fi
	out=$(printf '%s\n' "$pin" | pkexec "$admin" set 2>&1)
	rc=$?
	if [ "$rc" -eq 0 ]; then
		kdialog --title "$title" --msgbox "PIN set. Type it instead of your password at the login screen or the lock screen."
		exit 0
	fi
	# Exit 126/127 is pkexec itself: not authorised, or the prompt was closed.
	[ "$rc" -ge 126 ] && exit 0
	kdialog --title "$title" --sorry "$out"
done
