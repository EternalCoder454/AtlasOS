#!/usr/bin/env bash
# Gives an install made before AtlasOS shipped greenboot the GRUB boot counter
# ("start", at boot), and drops a stale counter when the user rolls back
# ("stop", at shutdown).
#
# start: bootupd writes /boot/grub2/grub.cfg once, at install, from the snippets
# in /usr/lib/bootupd/grub2-static/configs.d of the image it installed from. It
# never rewrites it on update, so the image's 08_greenboot.cfg only reaches new
# installs. GRUB does source /boot/grub2/custom.cfg (the 41_custom snippet,
# after blscfg), and bootupd leaves that file alone, so this puts the same
# snippet there, between markers, keeping anything else the user has in it.
# Idempotent: nothing is written when the file already says the right thing.
# When grub.cfg has the greenboot snippet itself (a fresh install, or a
# regenerated one) our block is removed again, or the counter would count down
# twice per boot.
#
# stop: while an update is failing, boot_counter counts down in grubenv. If the
# user then runs `bootc rollback` (queued, applied at this shutdown) to an image
# without greenboot, nothing there would ever clear the counter, and GRUB would
# count it to 0 and boot the broken image again. bootc status says
# rollbackQueued, so the counter is unset here, while the running image still
# knows. (greenboot's own rollback clears it itself.)
set -euo pipefail

boot=/boot/grub2
cfg=$boot/grub.cfg
custom=$boot/custom.cfg
grubenv=$boot/grubenv
snippet=/usr/lib/bootupd/grub2-static/configs.d/08_greenboot.cfg
begin='# BEGIN atlasos-greenboot (atlasos-grub-greenboot.service, do not edit)'
end='# END atlasos-greenboot'

say() { echo "atlasos-grub-greenboot: $*"; }

# /boot is read-only; the unit runs in its own mount namespace (MountFlags=slave).
boot_rw() {
	if mountpoint -q /boot; then
		mount -o remount,rw /boot
	fi
}

if [ "${1:-start}" = stop ]; then
	[ -f "$grubenv" ] || exit 0
	grub2-editenv "$grubenv" list 2>/dev/null | grep -q '^boot_counter=' || exit 0
	queued=$(timeout 30 bootc status --json 2>/dev/null | jq -r '.status.rollbackQueued // false' 2>/dev/null) || exit 0
	if [ "$queued" = true ]; then
		boot_rw || exit 0
		grub2-editenv "$grubenv" unset boot_counter && say "rollback queued: cleared the stale boot_counter"
	fi
	exit 0
fi

[ -f "$snippet" ] || {
	say "this image has no $snippet; nothing to do"
	exit 0
}
# Only a bootupd static config is known to source custom.cfg.
if [ ! -f "$cfg" ] || [ -L "$cfg" ] || ! grep -q '^# Generated by bootupd' "$cfg" ||
	! grep -qF 'custom.cfg' "$cfg"; then
	say "$cfg is not a bootupd static config that sources custom.cfg; leaving GRUB alone"
	exit 0
fi

has_block=0
if [ -f "$custom" ] && grep -qxF "$begin" "$custom"; then
	grep -qxF "$end" "$custom" || {
		say "$custom has our BEGIN marker but no END; leaving it alone"
		exit 1
	}
	has_block=1
fi

# custom.cfg without our block.
strip() {
	[ -f "$custom" ] || return 0
	awk -v b="$begin" -v e="$end" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$custom"
}
block() {
	echo "$begin"
	cat "$snippet"
	[ -z "$(tail -c1 "$snippet")" ] || echo # the greenboot RPM's file has no final newline
	echo "$end"
}

# The greenboot snippet in grub.cfg: bootupd's section marker, or a line only
# the snippet has (not just "boot_counter", which other GRUB code may use).
if grep -qxF '### BEGIN 08_greenboot.cfg ###' "$cfg" ||
	grep -qxF '# greenboot support, aka boot counter and boot success reporting' "$cfg"; then
	action=remove
	if [ "$has_block" = 0 ]; then
		say "grub.cfg has the greenboot snippet; nothing to do"
		exit 0
	fi
else
	action=install
fi

stripped=$(strip)
tmp=$(mktemp -p /run -t grub-greenboot.XXXXXX)
new=
trap 'rm -f "$tmp" "$new"' EXIT
{
	[ -z "$stripped" ] || printf '%s\n\n' "$stripped"
	[ "$action" = remove ] || block
} >"$tmp"

if [ "$action" = install ]; then
	if cmp -s "$tmp" "$custom" 2>/dev/null; then
		say "$custom is up to date"
		exit 0
	fi
	# Refuse to install a file GRUB could not parse.
	if command -v grub2-script-check >/dev/null; then
		grub2-script-check "$tmp" || {
			say "the new custom.cfg does not pass grub2-script-check; leaving GRUB alone"
			exit 1
		}
	else
		say "warning: grub2-script-check is missing, the new custom.cfg is unchecked"
	fi
fi

boot_rw || {
	say "cannot make /boot writable; leaving GRUB alone"
	exit 0
}

if [ ! -s "$tmp" ]; then
	rm -f "$custom"
	say "removed $custom, which held only our block (grub.cfg has the snippet)"
else
	if ! new=$(mktemp -p "$boot" .custom.cfg.XXXXXX 2>/dev/null); then
		say "cannot write to $boot (read-only /boot?); leaving GRUB alone"
		new=
		exit 0
	fi
	cat "$tmp" >"$new"
	if [ -f "$custom" ]; then
		chmod --reference="$custom" "$new"
	else
		chmod 0600 "$new"
	fi
	sync "$new"
	mv -f "$new" "$custom"
	new=
	if [ "$action" = install ]; then
		say "wrote the greenboot boot counter to $custom"
	else
		say "removed our block from $custom (grub.cfg has the snippet)"
	fi
fi
sync -f "$boot"
