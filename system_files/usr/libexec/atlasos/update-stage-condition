#!/bin/sh
# ExecCondition of atlasos-update-stage.service: exit 0 to go ahead, 1 to skip
# this run quietly. Skips
#  - on metered connections, using NetworkManager's own overall verdict (the
#    Metered property: 0 unknown, 1 yes, 2 no, 3 guess-yes, 4 guess-no);
#  - when the newest image is the one this machine went back from: the
#    rollback deployment. After "Go back" in Atlas Updater (or greenboot's
#    automatic rollback) the image left behind stays on the registry until a
#    newer one is published, and staging it again would undo the user's choice
#    at the next reboot. Updating to it by hand in Atlas Updater still works.
#  - when the newest image failed its boot health checks and was rolled back
#    (/var/lib/atlasos/bad-image-digests, written by the greenboot red.d
#    script), so a bad update isn't staged again even after the rollback
#    deployment is gone.
# A newer image has a new digest and goes ahead. If NetworkManager, bootc or
# the registry can't be asked, the run goes ahead.
metered=$(busctl --system get-property org.freedesktop.NetworkManager \
	/org/freedesktop/NetworkManager org.freedesktop.NetworkManager Metered 2>/dev/null) || metered=
case $metered in
"u 1" | "u 3")
	echo "metered connection; not downloading an update now"
	exit 1
	;;
esac

# `upgrade --check` fetches only the manifest and records it as the booted
# entry's cachedUpdate, with the digest bootc itself would deploy (for a
# multi-arch image, this machine's entry), the same digest bootc status shows
# for a deployment and the red.d script records.
timeout 300 bootc upgrade --check >/dev/null 2>&1 || exit 0
status=$(timeout 30 bootc status --json 2>/dev/null) || exit 0
latest=$(printf '%s' "$status" | jq -r '.status.booted.cachedUpdate.imageDigest // empty' 2>/dev/null)
[ -n "$latest" ] || exit 0
rollback=$(printf '%s' "$status" | jq -r '.status.rollback.image.imageDigest // empty' 2>/dev/null)
if [ "$latest" = "$rollback" ]; then
	echo "$latest is the version this machine went back from; waiting for a newer image"
	exit 1
fi
bad=/var/lib/atlasos/bad-image-digests
if [ -s "$bad" ] && grep -qxF "$latest" "$bad"; then
	echo "$latest failed its boot health checks and was rolled back; waiting for a newer image"
	exit 1
fi
exit 0
