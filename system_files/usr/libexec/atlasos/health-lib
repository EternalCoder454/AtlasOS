#!/usr/bin/env bash
# Shared by AtlasOS's greenboot checks (/usr/lib/greenboot/check/required.d).
# Sourced, never run on its own. A check sets hc_name, sources this, calls
# hc_guard, and ends in hc_pass or hc_fail. Each leaves one line on stdout
# (greenboot puts it in the journal of greenboot-healthcheck.service) and its
# result in /run/atlasos/health/<name>, which red.d reads to name what failed.
# Checks must not fail a boot for something that is not broken: offline,
# a headless target and a replaced display manager all pass.

hc_dir=/run/atlasos/health

# shellcheck disable=SC2154 # hc_name is set by the check that sources this
hc_report() { # status, message
	mkdir -p "$hc_dir" 2>/dev/null || true
	# greenboot runs scripts with `bash -C`: >| overwrites anyway.
	printf '%s: %s\n' "$1" "$2" >|"$hc_dir/$hc_name" 2>/dev/null || true
	echo "atlasos-health $hc_name: $1: $2"
}
hc_warn() { logger -t atlasos-health -p daemon.warning "$hc_name: $1" 2>/dev/null || true; }
hc_pass() { hc_report ok "$1"; exit 0; }
hc_fail() { hc_report FAILED "$1"; exit 1; }

# Run the whole check again under timeout(1), in case a command hangs.
# timeout(1) counts wall time, which includes suspend, so running out of it
# proves nothing: a timeout or a crash of the check itself passes (a bad
# update is judged by the check's own awake-time deadline, never by this).
hc_guard() { # seconds
	[ -z "${ATLAS_HC_INNER:-}" ] || return 0
	local rc=0
	ATLAS_HC_INNER=1 timeout -k 5 "$1" bash "$0" || rc=$?
	case $rc in
	0) exit 0 ;;
	1) exit 1 ;;
	124 | 137)
		hc_warn "the check did not finish within $1 s (suspend or a hung command); passing it"
		hc_pass "did not finish within $1 s (suspend or a hung command); not counted as a failure"
		;;
	*)
		hc_warn "the check itself failed (status $rc); passing it"
		hc_pass "the check itself failed (status $rc); not counted as a failure"
		;;
	esac
}

# Whole seconds since boot. Includes time spent suspended.
hc_uptime() {
	local up
	read -r up _ </proc/uptime
	echo "${up%.*}"
}

# The deadlines count awake time: hc_awake starts at the uptime and grows by
# hc_sleep, whose sleep(1) clock stops during suspend. A laptop that suspends
# in the window therefore doesn't run out of time.
hc_awake=0
hc_deadline=0
hc_set_deadline() { # seconds since boot: this, or 30 s from now when started late
	hc_awake=$(hc_uptime)
	hc_deadline=$(($1 > hc_awake + 30 ? $1 : hc_awake + 30))
}
hc_sleep() {
	sleep "$1"
	hc_awake=$((hc_awake + $1))
}
hc_expired() { [ "$hc_awake" -ge "$hc_deadline" ]; }

# With no rollback image a failure could only reboot in a loop (greenboot's
# `bootc rollback` fails with one deployment), so the check passes.
hc_skip_without_rollback() {
	local st
	command -v jq >/dev/null || {
		hc_warn "jq is missing, so the rollback deployment can't be read"
		hc_pass "skipped, jq is missing"
	}
	st=$(timeout 30 bootc status --json 2>/dev/null) || {
		hc_warn "bootc status failed, so the rollback deployment can't be read"
		hc_pass "skipped, bootc status is unavailable"
	}
	case $(jq -r 'if .status.rollback == null then "none" else "some" end' <<<"$st" 2>/dev/null) in
	some) ;;
	none) hc_pass "skipped, there is no rollback deployment to fall back to" ;;
	*)
		hc_warn "bootc status gave output jq can't read"
		hc_pass "skipped, bootc status is unreadable"
		;;
	esac
}

# Passes the check when a login screen isn't expected or can't be judged. When
# in doubt a check passes: a false failure reboots a healthy machine.
hc_skip_unless_plasmalogin() {
	local a args
	read -ra args </proc/cmdline
	for a in "${args[@]}"; do
		case $a in
		systemd.unit=graphical.target | systemd.unit=graphical) ;;
		systemd.unit=* | systemd.run=* | single | s | S | 1 | 2 | 3 | 4 | emergency | rescue)
			hc_pass "skipped, this boot is not a graphical one ($a)"
			;;
		esac
	done
	[ "$(systemctl get-default 2>/dev/null)" = graphical.target ] ||
		hc_pass "skipped, the default target is not graphical.target"
	[ "$(systemctl show -p Id --value display-manager.service 2>/dev/null)" = plasmalogin.service ] ||
		hc_pass "skipped, the display manager is not plasmalogin"
	[ "$(systemctl show -p LoadState --value plasmalogin.service 2>/dev/null)" != masked ] ||
		hc_pass "skipped, plasmalogin.service is masked"
	# The first-run wizard runs before the display manager, with no greeter.
	if [ -f /usr/lib/systemd/system/plasma-setup.service ] && [ ! -e /etc/plasma-setup-done ]; then
		hc_pass "skipped, first-run setup (plasma-setup) has not finished"
	fi
	hc_skip_without_rollback
}

# A failed login or Plasma check, unless the machine has no display to show it
# on (a headless box with graphical.target, where DRM may also appear late).
hc_fail_graphical() {
	# shellcheck disable=SC2144
	if ! compgen -G '/dev/dri/card*' >/dev/null; then
		hc_pass "skipped, there is no display device (/dev/dri/card*)"
	fi
	hc_fail "$1"
}

# A process only counts when it has lived 10 s: a crash-restart loop always
# has a young process.
hc_stable() { # pid
	local t
	t=$(ps -o etimes= -p "$1" 2>/dev/null | tr -d ' ')
	[ -n "$t" ] && [ "$t" -ge 10 ]
}

# First pid among $@ that is stable, or nothing.
hc_first_stable() {
	local p
	for p in "$@"; do
		if hc_stable "$p"; then
			echo "$p"
			return 0
		fi
	done
	return 1
}

hc_greeter_pids() { pgrep -f '^/usr/libexec/plasma-login-greeter' || true; }
hc_plasmashell_pids() { pgrep -x plasmashell || true; }
